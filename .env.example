# Django asosiy sozlamalari
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=almashtiring-bu-kalitni-kamida-50-belgili-tasodifiy-matnga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Ma'lumotlar bazasi (PostgreSQL production uchun tavsiya etiladi)
# Lokal ishlab chiqishda bo'sh qoldirilsa SQLite (db.sqlite3) ishlatiladi
# DATABASE_URL=postgresql://turon_user:kuchli_parol@127.0.0.1:5432/turon_odob_ilm
DATABASE_URL=

# Maxfiylik va analitika uchun tuz (salt)
ANALYTICS_SALT=turon-odob-ilm-maxfiy-tuz-ozgartiring

# HTTPS va xavfsizlik (production muhitida True qiling)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
ENABLE_2FA_ENFORCEMENT=False

# Google Business Profile rasmiy API (ixtiyoriy, faqat ruxsat bo'lganda)
GOOGLE_BUSINESS_API_ENABLED=False
GOOGLE_BUSINESS_CREDENTIALS_PATH=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Yandex Business rasmiy API (ixtiyoriy, faqat ruxsat bo'lganda)
YANDEX_BUSINESS_API_ENABLED=False
YANDEX_BUSINESS_API_TOKEN=
YANDEX_BUSINESS_ORG_ID=

# Log darajasi
LOG_LEVEL=INFO
